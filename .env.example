# AI keys are best added in the app (Settings → AI model, stored encrypted). These env vars are an optional fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
READER_DATABASE_URL=postgresql://rag_reader:rag_reader@localhost:5433/rag
AGENT_MODEL=claude-opus-5-5
CRITIC_MODEL=claude-haiku-5-5
# AGENT_MODE=search  # no AI calls at all (search results + calculated spreadsheet insights)


# Encrypts connector tokens and OAuth secrets at rest. Required. Back it up: losing it means reconnecting every source.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Where the backend and frontend are reachable (OAuth redirect URLs and cookie security derive from these).
# Use https:// in production: cookies become Secure automatically.
PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SYNC_INTERVAL_MINUTES=30
